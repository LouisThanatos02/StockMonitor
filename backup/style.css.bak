*{box-sizing:border-box}body{margin:0;background:#10151d;color:#e7edf4;font-family:system-ui,-apple-system,"Noto Sans TC",sans-serif;padding-bottom:env(safe-area-inset-bottom);font-size:15px}.top{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:#171e28;border-bottom:1px solid #2b3542;position:sticky;top:0;z-index:5}.brand{font-weight:800;letter-spacing:1.5px}.top small{color:#8c9aaa;font-size:11px}.iconbtn{background:#27313d;border:1px solid #344252;color:#dce6f0;border-radius:12px;font-size:18px;padding:8px 12px}.tabs{display:flex;position:sticky;top:58px;background:#171e28;z-index:4;border-bottom:1px solid #303c49}.tab{flex:1;border:0;background:none;color:#94a4b5;padding:14px 6px;font-weight:700}.tab.active{color:#fff;border-bottom:2px solid #39c8a2}.market-tabs{display:flex;gap:8px;padding:12px 14px 4px}.market{border:1px solid #34414e;border-radius:20px;padding:8px 16px;background:#1b2530;color:#a9b7c6}.market.active{background:#21483f;color:#7fe3bd;border-color:#367b67}.addrow{display:flex;gap:8px;padding:10px 14px}.addrow input{flex:1;min-width:0}input,select{background:#1b2530;color:#f1f5f8;border:1px solid #34414e;border-radius:10px;padding:12px;font-size:15px;outline:none}input::placeholder{color:#7e8b9a}.addrow button,.position-form button,.wide{background:#2f9e7d;color:#fff;border:0;border-radius:10px;padding:12px 15px;font-weight:700}.list{padding:8px 12px 30px}.stock-card{background:#171f29;border:1px solid #2b3947;border-radius:14px;margin:10px 0;overflow:hidden}.card-head{display:flex;align-items:center;gap:8px;padding:12px;border-bottom:1px solid #27333f}.ticker{font-weight:800}.stock-name{color:#8e9eae;font-size:12px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.price{font-weight:800;font-size:20px}.up{color:#48d19a}.down{color:#ff6b78}.muted{color:#8796a7}.mini{font-size:12px}.smallbtn{background:#25313d;color:#aebccc;border:1px solid #344250;border-radius:8px;padding:6px 9px}.card-body{padding:12px}.signal-row{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.pill{font-size:12px;border-radius:99px;padding:5px 9px;background:#24323d;color:#bac9d6}.pill.good{background:#1d3d34;color:#75ddb4}.pill.bad{background:#43262e;color:#ff8994}.pill.warn{background:#433a23;color:#e6c676}.details{margin-top:8px}.details summary{padding:10px;background:#202b36;border-radius:9px;color:#bdc9d6}.chart-tabs{display:flex;gap:5px;margin:12px 0}.chart-tabs button{flex:1;background:#202b36;border:1px solid #334250;color:#aebdca;border-radius:8px;padding:9px}.chart-tabs button.active{color:#fff;border-color:#36b990;background:#20443a}.chart{width:100%;height:310px}.hint{color:#8392a3;font-size:12px;line-height:1.5}h2{padding:0 14px;font-size:20px}h3{padding:0 14px}.position-form{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px}.position-form button{grid-column:1/-1}.position{margin:10px 14px;background:#1b2530;border:1px solid #34414e;border-radius:12px;padding:12px}.position-form input{min-width:0}#positionList{padding-bottom:24px}label{display:block;padding:12px;color:#bac8d6}label input{display:block;width:100%;margin-top:6px}.wide{margin:12px;width:calc(100% - 24px)}.hidden{display:none!important}#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#2d3c49;color:#fff;padding:12px 16px;border-radius:12px;display:none;z-index:10;box-shadow:0 8px 24px #0006}.empty{padding:30px;text-align:center;color:#7f8d9d}@media(min-width:720px){main{max-width:900px;margin:auto}.list{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stock-card{margin:0}.chart{height:390px}}
