<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#10151d"><title>Stock Monitor</title><link rel="manifest" href="/static/manifest.json"><link rel="stylesheet" href="/static/style.css"></head><body>
<header class="top"><div><div class="brand">STOCK MONITOR</div><small>Mobile · Strategy Monitor</small></div><button class="iconbtn" onclick="showSettings()">⚙</button></header>
<nav class="tabs"><button class="tab active" onclick="switchTab('watch',this)">監控</button><button class="tab" onclick="switchTab('positions',this)">模擬持倉</button><button class="tab" onclick="switchTab('settings',this)">設定</button></nav>
<main><section id="watch"><div class="market-tabs"><button class="market active" onclick="setMarket('TW',this)">台股</button><button class="market" onclick="setMarket('US',this)">美股</button></div><div class="addrow"><input id="symbol" placeholder="股票代號，例如 2330 或 NVDA" autocapitalize="characters"><button onclick="addStock()">＋ 加入</button></div><div id="watchlist" class="list"></div></section>
<section id="positions" class="hidden"><h2>模擬持倉</h2><div class="position-form"><input id="posTicker" placeholder="代號"><select id="posMarket"><option value="TW">台股</option><option value="US">美股</option></select><select id="posSide"><option value="LONG">做多</option><option value="SHORT">模擬放空</option></select><input id="posQty" type="number" min="0" step="1" placeholder="股數"><input id="posPrice" type="number" min="0" step="0.01" placeholder="成本價格"><button onclick="addPosition()">新增模擬持倉</button></div><div id="positionList"></div></section>
<section id="settings" class="hidden"><h2>設定</h2><label>更新頻率（秒）<input id="refresh" type="number" min="30" value="60"></label><label>元大 API Key（預留）<input id="yuantaKey" type="password" placeholder="未設定時使用 Yahoo Finance"></label><button class="wide" onclick="saveSettings()">儲存設定</button><p class="hint">目前行情來源為 Yahoo Finance。API Key 僅保存於本機 SQLite，尚未接入元大 API。</p><h3>功能提醒</h3><p class="hint">自動模擬開關目前僅保存設定，不會送出任何真實委託。</p></section></main><div id="toast"></div><script src="/static/app.js"></script></body></html>
