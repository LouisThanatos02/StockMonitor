let market='TW';
function toast(msg){let t=document.getElementById('toast');t.textContent=msg;t.style.display='block';setTimeout(()=>t.style.display='none',2200)}
function switchTab(tab,btn){document.querySelectorAll('main section').forEach(s=>s.classList.add('hidden'));document.getElementById(tab).classList.remove('hidden');document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');if(tab==='positions')loadPositions();if(tab==='settings')loadSettings()}
function showSettings(){switchTab('settings',document.querySelectorAll('.tab')[2])}
function setMarket(m,btn){market=m;document.querySelectorAll('.market').forEach(b=>b.classList.remove('active'));btn.classList.add('active');loadWatchlist()}
async function api(url,opts={}){let r=await fetch(url,{headers:{'Content-Type':'application/json'},...opts});let j=await r.json();if(!r.ok)throw Error(j.error||'Request failed');return j}
function sid(s){return s.replace(/[^a-zA-Z0-9_-]/g,'_')}
async function addStock(){let inp=document.getElementById('symbol'),v=inp.value.trim();if(!v)return toast('請輸入股票代號');try{let r=await api('/api/watchlist',{method:'POST',body:JSON.stringify({ticker:v,market})});inp.value='';toast('已加入 '+r.ticker);loadWatchlist()}catch(e){toast(e.message)}}
async function loadWatchlist(){let rows=await api('/api/watchlist');let root=document.getElementById('watchlist');rows=rows.filter(r=>r.market===market);if(!rows.length){root.innerHTML='<div class="empty">尚未加入股票<br><span class="mini">輸入代號即可開始監控</span></div>';return}root.innerHTML='';rows.forEach(r=>{let card=document.createElement('article');card.className='stock-card';let id=sid(r.ticker);card.innerHTML=`<div class="card-head"><span class="ticker">${r.ticker}</span><span class="stock-name" id="name-${id}">行情載入中</span><button class="smallbtn" title="自動模擬判斷" onclick="toggle('${r.ticker}','auto_sim',${r.auto_sim?0:1})">${r.auto_sim?'🟢':'⚪'}</button><button class="smallbtn" onclick="toggle('${r.ticker}','collapsed',${r.collapsed?0:1})">${r.collapsed?'＋':'－'}</button><button class="smallbtn" onclick="removeStock('${r.ticker}')">✕</button></div><div id="body-${id}" class="card-body ${r.collapsed?'hidden':''}"><div id="quote-${id}" class="muted">載入行情…</div><div class="chart-tabs"><button class="active" onclick="loadChart('${r.ticker}','1d',this)">日</button><button onclick="loadChart('${r.ticker}','1wk',this)">週</button><button onclick="loadChart('${r.ticker}','1mo',this)">月</button></div><div id="chart-${id}" class="chart"></div><details class="details"><summary>做多／放空條件明細</summary><div id="conditions-${id}" class="hint"></div></details><p class="hint">自動模擬：${r.auto_sim?'已開啟（僅模擬）':'關閉'}；不會送出真實交易。</p></div>`;root.appendChild(card);loadChart(r.ticker,'1d',card.querySelector('.chart-tabs button'))})}
async function toggle(t,field,value){await api(`/api/watchlist/${encodeURIComponent(t)}/toggle`,{method:'POST',body:JSON.stringify({field,value})});if(field==='collapsed')loadWatchlist();else toast('模擬監控開關已更新')}
async function removeStock(t){if(!confirm(`移除監控 ${t}？`))return;await api(`/api/watchlist/${encodeURIComponent(t)}`,{method:'DELETE'});loadWatchlist()}
function renderPlot(t,rows){
  const div=document.getElementById('chart-'+sid(t)); if(!div)return;
  const x=rows.map(r=>r.Date);
  const candle={x,open:rows.map(r=>r.Open),high:rows.map(r=>r.High),low:rows.map(r=>r.Low),close:rows.map(r=>r.Close),type:'candlestick',name:'K線',increasing:{line:{color:'#ef6674'}},decreasing:{line:{color:'#45c997'}}};
  const ma=[5,10,20,60].map(n=>({x:x,y:rows.map(r=>r['MA'+n]),type:'scatter',mode:'lines',name:'MA'+n,line:{width:1.15}}));
  const kd=[
    {x:x,y:rows.map(r=>r.K),type:'scatter',mode:'lines',name:'K',xaxis:'x',yaxis:'y2',line:{color:'#55d5bd',width:1.3}},
    {x:x,y:rows.map(r=>r.D),type:'scatter',mode:'lines',name:'D',xaxis:'x',yaxis:'y2',line:{color:'#f4c568',width:1.3}}
  ];
  const layout={margin:{l:40,r:8,t:18,b:25},paper_bgcolor:'#171f29',plot_bgcolor:'#171f29',font:{color:'#b9c7d4',size:10},xaxis:{type:'date',rangeslider:{visible:false},gridcolor:'#293540'},yaxis:{domain:[.35,1],gridcolor:'#293540'},yaxis2:{domain:[0,.25],range:[0,100],gridcolor:'#293540'},legend:{orientation:'h',y:1.05,x:0},dragmode:'pan'};
  Plotly.newPlot(div,[candle,...ma,...kd],layout,{responsive:true,scrollZoom:true,displaylogo:false,modeBarButtonsToRemove:['zoom2d','select2d','lasso2d'],doubleClick:'reset'});
}
async function loadChart(t,interval,btn){try{let q=await api(`/api/quote/${encodeURIComponent(t)}?interval=${interval}`),id=sid(t);document.getElementById('name-'+id).textContent=q.name;let cls=q.change_pct>=0?'up':'down';document.getElementById('quote-'+id).innerHTML=`<div class="price">${Number(q.latest).toLocaleString(undefined,{maximumFractionDigits:2})} <span class="${cls} mini">${q.change_pct>=0?'+':''}${q.change_pct.toFixed(2)}%</span></div><div class="mini muted">${q.date} · ${q.change>=0?'+':''}${q.change.toFixed(2)}</div><div class="signal-row"><span class="pill ${q.strategy.long>=4?'good':'warn'}">做多 ${q.strategy.long}/6</span><span class="pill ${q.strategy.short>=4?'bad':'warn'}">放空 ${q.strategy.short}/6（觀察）</span><span class="pill">加強 ${q.strategy.boost_long}/3</span></div>`;renderPlot(t,q.data);let c=document.getElementById('conditions-'+id);c.innerHTML='<b>做多條件</b><br>'+q.strategy.long_conditions.map(x=>(x.ok?'🟢 ':'⚪ ')+x.label).join('<br>')+'<br><b>放空觀察</b><br>'+q.strategy.short_conditions.map(x=>(x.ok?'🔴 ':'⚪ ')+x.label).join('<br>')+'<br><b>做多加強條件</b><br>'+(q.strategy.boost_long_conditions||[]).map(x=>(x.ok?'⭐ ':'○ ')+x.label).join('<br>')+'<p>'+q.strategy.note+'</p>';if(btn){btn.parentElement.querySelectorAll('button').forEach(b=>b.classList.remove('active'));btn.classList.add('active')}}catch(e){let el=document.getElementById('quote-'+sid(t));if(el)el.innerHTML=`<span class="down">行情讀取失敗：${e.message}</span>`}}
async function loadPositions(){let arr=await api('/api/positions'),root=document.getElementById('positionList');root.innerHTML=arr.length?arr.map(p=>`<div class="position"><b>${p.ticker}</b> · ${p.market==='TW'?'台股':'美股'} · ${p.side==='LONG'?'做多':'模擬放空'}<br>數量 ${p.qty} · 成本 ${p.entry_price}<br><span class="hint">${p.opened_at}</span></div>`).join(''):'<div class="empty">尚無模擬持倉</div>'}
async function addPosition(){try{await api('/api/positions',{method:'POST',body:JSON.stringify({ticker:document.getElementById('posTicker').value.trim().toUpperCase(),market:document.getElementById('posMarket').value,side:document.getElementById('posSide').value,qty:document.getElementById('posQty').value,entry_price:document.getElementById('posPrice').value})});toast('模擬持倉已新增');loadPositions()}catch(e){toast(e.message)}}
async function loadSettings(){let s=await api('/api/settings');document.getElementById('refresh').value=s.refresh_seconds||60;document.getElementById('yuantaKey').value=s.yuanta_api_key||''}
async function saveSettings(){await api('/api/settings',{method:'POST',body:JSON.stringify({refresh_seconds:document.getElementById('refresh').value,yuanta_api_key:document.getElementById('yuantaKey').value})});toast('設定已儲存')}
loadWatchlist();loadSettings();
