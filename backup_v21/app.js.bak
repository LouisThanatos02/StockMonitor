let market='TW', refreshTimer=null;function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(refreshTimer);refreshTimer=setTimeout(()=>t.classList.remove('show'),2200)}
function switchTab(tab,btn){document.querySelectorAll('main section').forEach(s=>s.classList.add('hidden'));document.getElementById(tab).classList.remove('hidden');document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');if(tab==='positions')loadPositions();if(tab==='settings')loadSettings()}
function showSettings(){switchTab('settings',document.querySelectorAll('.tab')[2])}
function setMarket(m,btn){market=m;document.querySelectorAll('.market').forEach(b=>b.classList.remove('active'));btn.classList.add('active');loadWatchlist()}
async function api(url,opts={}){const r=await fetch(url,{headers:{'Content-Type':'application/json'},...opts});let j=await r.json();if(!r.ok)throw Error(j.error||'Request failed');return j}
function sid(s){return s.replace(/[^a-zA-Z0-9_-]/g,'_')}
async function addStock(){let inp=document.getElementById('symbol'),v=inp.value.trim();if(!v)return toast('請輸入股票代號');try{let r=await api('/api/watchlist',{method:'POST',body:JSON.stringify({ticker:v,market})});inp.value='';toast('已加入 '+r.ticker);loadWatchlist()}catch(e){toast(e.message)}}
async function loadWatchlist(){try{let rows=await api('/api/watchlist');let root=document.getElementById('watchlist');rows=rows.filter(r=>r.market===market);if(!rows.length){root.innerHTML='<div class="empty">尚未加入股票<br><span class="mini">輸入代號即可開始監控</span></div>';return}root.innerHTML='';rows.forEach(r=>{let card=document.createElement('article'),id=sid(r.ticker);card.className='stock-card';card.innerHTML=`<div class="card-head"><div class="ticker">${r.ticker}</div><div class="stock-name" id="name-${id}">行情載入中…</div><button class="smallbtn sim-toggle ${r.auto_sim?'on':''}" id="sim-${id}" onclick="toggle('${r.ticker}','auto_sim',${r.auto_sim?0:1})" aria-label="自動模擬">${r.auto_sim?'●':'○'}</button><button class="smallbtn" onclick="toggle('${r.ticker}','collapsed',${r.collapsed?0:1)}">${r.collapsed?'＋':'－'}</button><button class="smallbtn" onclick="removeStock('${r.ticker}')">✕</button></div><div id="body-${id}" class="card-body ${r.collapsed?'hidden':''}"><div id="quote-${id}" class="quote">載入行情…</div><div class="score-grid" id="scores-${id}"></div><details class="details"><summary>策略條件與加強明細</summary><div id="conditions-${id}" class="condition-details"></div></details><p class="hint sim-note">自動模擬：${r.auto_sim?'已開啟（僅模擬）':'關閉'}；不會送出真實交易。</p></div>`;root.appendChild(card);if(!r.collapsed)loadQuote(r.ticker)})}catch(e){toast('監控清單載入失敗：'+e.message)}}
async function toggle(t,field,value){try{await api(`/api/watchlist/${encodeURIComponent(t)}/toggle`,{method:'POST',body:JSON.stringify({field,value})});if(field==='collapsed'){loadWatchlist();return}const id=sid(t),btn=document.getElementById('sim-'+id),note=document.querySelector(`#body-${id} .sim-note`);if(btn){btn.textContent=value?'●':'○';btn.classList.toggle('on',!!value)}if(note)note.textContent=`自動模擬：${value?'已開啟（僅模擬）':'關閉'}；不會送出真實交易。`;toast('模擬監控開關已更新')}catch(e){toast(e.message)}}
async function removeStock(t){if(!confirm(`移除監控 ${t}？`))return;try{await api(`/api/watchlist/${encodeURIComponent(t)}`,{method:'DELETE'});loadWatchlist()}catch(e){toast(e.message)}}
function section(title,arr,positive){return `<div class="condition-group"><div class="condition-title">${title}</div>${(arr||[]).map(x=>`<div class="condition ${x.ok?'pass':'fail'}"><span class="state">${x.ok?'✓':'○'}</span><span>${x.label}</span></div>`).join('')}</div>`}
async function loadQuote(t){const id=sid(t);try{const q=await api(`/api/quote/${encodeURIComponent(t)}?interval=1d`);document.getElementById('name-'+id).textContent=q.name||t;const cls=q.change_pct>=0?'up':'down';document.getElementById('quote-'+id).innerHTML=`<div class="price-line"><span class="price">${Number(q.latest).toLocaleString(undefined,{maximumFractionDigits:2})}</span><span class="${cls} change">${q.change_pct>=0?'+':''}${q.change_pct.toFixed(2)}%</span></div><div class="quote-meta">${q.date}　${q.change>=0?'+':''}${Number(q.change).toFixed(2)}</div>`;const st=q.strategy||{},bl=(st.boost_long_conditions||[]).filter(x=>x.ok).length,bs=(st.boost_short_conditions||[]).filter(x=>x.ok).length;document.getElementById('scores-'+id).innerHTML=`<div class="score-card long"><div class="score-head"><span>做多</span><strong>${st.long||0}/6</strong></div><div class="boost">加強 <b>+${bl}</b> <small>（${bl} / 3）</small></div><div class="score-track"><i style="width:${Math.min(100,(st.long||0)/6*100)}%"></i></div></div><div class="score-card short"><div class="score-head"><span>做空</span><strong>${st.short||0}/6</strong></div><div class="boost">加強 <b>+${bs}</b> <small>（${bs} / 3）</small></div><div class="score-track"><i style="width:${Math.min(100,(st.short||0)/6*100)}%"></i></div></div>`;document.getElementById('conditions-'+id).innerHTML=section('做多條件（6項）',st.long_conditions)+section('做多加強（3項）',st.boost_long_conditions)+section('做空條件（6項）',st.short_conditions)+section('做空加強（3項）',st.boost_short_conditions)+`<p class="strategy-note">${st.note||''}</p>`}catch(e){document.getElementById('quote-'+id).innerHTML=`<span class="down">行情讀取失敗：${e.message}</span>`}}
async function loadPositions(){try{let arr=await api('/api/positions'),root=document.getElementById('positionList');root.innerHTML=arr.length?arr.map(p=>`<div class="position"><b>${p.ticker}</b> · ${p.market==='TW'?'台股':'美股'} · ${p.side==='LONG'?'做多':'模擬放空'}<br>數量 ${p.qty} · 成本 ${p.entry_price}<br><span class="hint">${p.opened_at}</span></div>`).join(''):'<div class="empty">尚無模擬持倉</div>'}catch(e){toast(e.message)}}
async function addPosition(){try{await api('/api/positions',{method:'POST',body:JSON.stringify({ticker:document.getElementById('posTicker').value.trim().toUpperCase(),market:document.getElementById('posMarket').value,side:document.getElementById('posSide').value,qty:document.getElementById('posQty').value,entry_price:document.getElementById('posPrice').value})});toast('模擬持倉已新增');loadPositions()}catch(e){toast(e.message)}}
async function loadSettings(){try{let s=await api('/api/settings');document.getElementById('refresh').value=s.refresh_seconds||60;document.getElementById('yuantaKey').value=s.yuanta_api_key||''}catch(e){}}
async function saveSettings(){try{await api('/api/settings',{method:'POST',body:JSON.stringify({refresh_seconds:document.getElementById('refresh').value,yuanta_api_key:document.getElementById('yuantaKey').value})});toast('設定已儲存')}catch(e){toast(e.message)}}
loadWatchlist();loadSettings();
